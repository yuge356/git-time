APP_SECRET_KEY=replace_with_at_least_32_random_characters
# Copy the Session pooler URI from Supabase > Connect, change postgresql:// to
# postgresql+asyncpg://, and URL-encode special characters in the password.
APP_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
APP_DATABASE_ROLE=dayflow_app
APP_CORS_ORIGINS=["http://localhost:8080"]
APP_AUTH_PROVIDER=supabase
APP_SUPABASE_URL=https://PROJECT_REF.supabase.co
APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

HTTP_PORT=8080
