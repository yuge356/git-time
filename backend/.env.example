APP_ENVIRONMENT=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
APP_DATABASE_URL=postgresql+asyncpg://time_budget_app:time_budget_dev_password@localhost:5432/time_budget_tracker
# Set this to dayflow_app with Supabase. Leave blank for local SQLite/Postgres.
APP_DATABASE_ROLE=
APP_CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
APP_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Use "supabase" in the MVP environment. "local" keeps the legacy test/dev
# account endpoints available without an external service.
APP_AUTH_PROVIDER=local
APP_SUPABASE_URL=https://your-project-ref.supabase.co
APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
